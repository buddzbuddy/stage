# Copy to .env.stage; every command must include --env-file .env.stage.
# Use your Docker Hub namespace and an immutable version tag (or image digest).
USTA_API_IMAGE=buddzbuddy/usta-api:stage-20261027-1
POSTGRES_IMAGE=postgres:17-alpine
# Republish the existing MinIO image from the source Docker host; see usta/STAGE.md.
MINIO_IMAGE=buddzbuddy/usta-minio:stage-source-1
POSTGRES_DB=usta
POSTGRES_USER=kyzmet
# For the connection-string password, use a long random alphanumeric value.
POSTGRES_PASSWORD=kyzmet_dev_password
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_BUCKET=kyzmet-order-attachments
# Keep the existing hash key if transferring still-valid phone challenges.
PHONE_CODES_HASH_KEY=development-only-phone-code-hash-key
SUBSCRIPTION_WEBHOOK_SECRET=development-only-webhook-secret-key
OPENAI_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
# Optional external embedding service; not included in this three-service stack.
EMBEDDING_SERVICE_URL=http://host.docker.internal:8092
STAGE_BIND_ADDRESS=127.0.0.1
API_PORT=5081
POSTGRES_PORT=5434
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
