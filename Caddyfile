{
    # IP clients may omit SNI during the TLS handshake.
    default_sni 192.168.1.183
}

topoz.kg {
    encode zstd gzip

    @api path /api /api/*
    handle @api {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy topoz-frontend:8080
    }
}

https://192.168.1.183:5083 {
    tls internal
    encode zstd gzip
    reverse_proxy admin-web:80
}
