{
    # IP clients may omit SNI during the TLS handshake.
    default_sni 192.168.1.183
}

topoz.kg {
    encode zstd gzip

    @api path /api /api/*
    handle @api {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy topoz-frontend:8080
    }
}

# MinIO checks signed photo links against this host and the bucket path: forward both unchanged.
media.topoz.kg {
    @photos {
        method GET HEAD
        path /kyzmet-order-attachments/*
    }
    handle @photos {
        reverse_proxy minio:9000
    }

    handle {
        respond 404
    }
}

https://192.168.1.183:5083 {
    tls internal
    encode zstd gzip
    reverse_proxy admin-web:80
}
