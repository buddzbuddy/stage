{
    # IP clients may omit SNI during the TLS handshake.
    default_sni 192.168.1.183
}

(access_log) {
    log {
        output file /var/log/caddy/{args[0]}.log {
            roll_size 100MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format filter {
            request>uri query {
                delete X-Amz-Signature
                delete X-Amz-Credential
            }
            # The API answers a private photo with a 302 to its signed link.
            resp_headers>Location query {
                delete X-Amz-Signature
                delete X-Amz-Credential
            }
            wrap json
        }
    }
}

topoz.kg {
    import access_log topoz
    encode zstd gzip

    @api path /api /api/*
    handle @api {
        log_append kind api
        reverse_proxy api:8080
    }

    # MinIO checks signed photo links against this host and the bucket path: forward both unchanged.
    @photos path /kyzmet-order-attachments/*
    handle @photos {
        log_append kind photos
        @write not method GET HEAD
        respond @write 405
        reverse_proxy minio:9000
    }

    handle {
        log_append kind front
        reverse_proxy topoz-frontend:8080
    }
}

https://192.168.1.183:5083 {
    import access_log admin
    log_append kind admin
    tls internal
    encode zstd gzip
    reverse_proxy admin-web:80
}

https://192.168.1.183:5084 {
    tls internal
    reverse_proxy grafana:3000
}
