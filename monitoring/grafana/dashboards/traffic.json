    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 времени ответа API, топ-10 маршрутов",
      "description": "Хаб SignalR исключён: его соединения живут минутами.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, quantile_over_time(0.95, {job=\"caddy\", kind=\"api\"} | agent != \"probe\" | route !~ \"/hubs/.*\" | json duration | keep route, duration | unwrap duration [$__interval]) by (route))",
          "queryType": "range",
          "legendFormat": "{{route}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
