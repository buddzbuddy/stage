{
  "uid": "traffic",
  "title": "Трафик",
  "description": "Журнал запросов Caddy: фронт, API, фото и админка.",
  "tags": [
    "caddy"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "kind",
        "label": "Вид трафика",
        "type": "custom",
        "query": "api,front,photos,admin",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Запросы за период",
      "description": "Число строк журнала Caddy за выбранный период по видам трафика.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (kind) (count_over_time({job=\"caddy\", kind=~\"$kind\"} | agent != \"probe\" | keep kind [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{kind}}",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"caddy\", kind=~\"$kind\"} | agent != \"probe\" | keep kind [$__range]))",
          "queryType": "instant",
          "legendFormat": "всего",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__data.fields.kind}",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "всего"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Отдано за период",
      "description": "Сумма size — байты тел ответов, отданные клиентам после сжатия.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (kind) (sum_over_time({job=\"caddy\", kind=~\"$kind\"} | agent != \"probe\" | json size | keep kind, size | unwrap size [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{kind}}",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({job=\"caddy\", kind=~\"$kind\"} | agent != \"probe\" | json size | keep kind, size | unwrap size [$__range]))",
          "queryType": "instant",
          "legendFormat": "всего",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "displayName": "${__data.fields.kind}",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "всего"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Запросы в секунду",
      "description": "Всплески здесь — первый признак DDoS или нагрузочного прогона.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (kind) (rate({job=\"caddy\", kind=~\"$kind\"} | agent != \"probe\" | keep kind [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{kind}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ответы по классам статусов",
      "description": "Число ответов за интервал. SPA отвечает 200 на любой путь, поэтому сканеры фронта — в 2xx.",
