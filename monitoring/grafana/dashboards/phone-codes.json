    {
      "id": 1,
      "type": "stat",
      "title": "Коды за период",
      "description": "Сообщения с кодом, которые принял провайдер. SMS без ответа Nikita в срок (unknown) тоже считается: скорее всего, оно ушло.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(phone_codes_outcomes_total{outcome=~\"sent|unknown\"}[$__range]))",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
