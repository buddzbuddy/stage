    },
    {
      "id": 2,
      "type": "stat",
      "title": "Через мессенджеры",
      "description": "Доля оплачиваемых сообщений WhatsApp и Telegram. Код WhatsApp, о недоставке которого сообщила Meta, не считается: вместо него ушло SMS.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(((sum(increase(phone_codes_outcomes_total{channel=\"whatsapp\", outcome=\"sent\"}[$__range])) or vector(0)) - (sum(increase(phone_codes_outcomes_total{channel=\"whatsapp\", reason=\"undelivered\"}[$__range])) or vector(0))) + (sum(increase(phone_codes_outcomes_total{channel=\"telegram\", outcome=\"sent\"}[$__range])) or vector(0))) / ((sum(increase(phone_codes_outcomes_total{channel=\"sms\", outcome=~\"sent|unknown\"}[$__range])) or vector(0)) + ((sum(increase(phone_codes_outcomes_total{channel=\"whatsapp\", outcome=\"sent\"}[$__range])) or vector(0)) - (sum(increase(phone_codes_outcomes_total{channel=\"whatsapp\", reason=\"undelivered\"}[$__range])) or vector(0))) + (sum(increase(phone_codes_outcomes_total{channel=\"telegram\", outcome=\"sent\"}[$__range])) or vector(0)))",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
