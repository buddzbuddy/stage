        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(phone_codes_outcomes_total{channel=\"sms\", outcome=~\"sent|unknown\"}[$__range])) or vector(0)) * $sms_price + ((sum(increase(phone_codes_outcomes_total{channel=\"whatsapp\", outcome=\"sent\"}[$__range])) or vector(0)) - (sum(increase(phone_codes_outcomes_total{channel=\"whatsapp\", reason=\"undelivered\"}[$__range])) or vector(0))) * $whatsapp_price + (sum(increase(phone_codes_outcomes_total{channel=\"telegram\", outcome=\"sent\"}[$__range])) or vector(0)) * $telegram_price",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: сом",
          "decimals": 2,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
