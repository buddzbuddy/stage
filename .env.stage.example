# Copy to .env.stage; every command must include --env-file .env.stage.
# Use your Docker Hub namespace and an immutable version tag (or image digest).
USTA_API_IMAGE=buddzbuddy/usta-api:latest
USTA_ADMIN_API_IMAGE=buddzbuddy/usta-admin-api:latest
USTA_ADMIN_WEB_IMAGE=buddzbuddy/usta-admin-web:latest
POSTGRES_IMAGE=postgres:17-alpine
# Republish the existing MinIO image from the source Docker host; see usta/STAGE.md.
MINIO_IMAGE=buddzbuddy/usta-minio:stage-source-1
POSTGRES_DB=usta
POSTGRES_USER=
# For the connection-string password, use a long random alphanumeric value.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=kyzmet-order-attachments
# The HTTPS address browsers load photos from; Caddy forwards its bucket path to MinIO.
MINIO_PUBLIC_URL=https://topoz.kg
# Keep the existing hash key if transferring still-valid phone challenges.
PHONE_CODES_HASH_KEY=
SUBSCRIPTION_WEBHOOK_SECRET=
OPENAI_API_KEY=
FRONTEND_ORIGIN=https://topoz.kg
# Optional external embedding service; not included in this stack.
EMBEDDING_SERVICE_URL=http://host.docker.internal:8092
DISCOVERY_ENABLED=true
DISCOVERY_ALTERNATIVE_ADMISSION_PROFILE=primary-or-explicit-intents-v3
STAGE_BIND_ADDRESS=0.0.0.0
API_PORT=5081
# The server's IP in the LAN: Caddy serves the admin panel (5083) and Grafana (5084) only at it.
SERVER_LAN_ADDRESS=192.168.88.253
ADMIN_API_PORT=5082
POSTGRES_PORT=5433
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
FRONTEND_PORT=3000
FRONTEND_BIND_ADDRESS=0.0.0.0
TOPOS_FRONTEND_IMAGE=sonetbrashear/topoz-web:0.1.1
